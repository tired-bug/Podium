# ── Required ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# ── AI (get free key at console.groq.com) ─────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

ANTHROPIC_API_KEY=YOUR_GEMINI_API_KEY
ANTHROPIC_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ANTHROPIC_MODEL=gemini-2.5-flash

# ── Turso (free persistent database — turso.tech) ────────────────────────────
# Without these, the app uses local SQLite (data lost on Render redeploy)
# With these, data persists permanently across all redeploys
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# ── CORS (set to your Cloudflare Pages URL in production) ─────────────────────
# ALLOWED_ORIGINS=https://podium-xxxx.pages.dev

# ── Cloud Providers (all optional) ───────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

GITHUB_TOKEN=
