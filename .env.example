# ── Required ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# ── AI (get free key at console.groq.com/keys) ──────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Optional — defaults to openai/gpt-oss-120b. Change this if Groq's free
# tier changes for a given model, without touching any application code.
AI_MODEL=openai/gpt-oss-120b

# ── Turso (free persistent database — turso.tech) ────────────────────────────
# Without these, the app uses local SQLite (data lost on Render redeploy)
# With these, data persists permanently across all redeploys
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# ── CORS (set to your Cloudflare Pages URL in production) ─────────────────────
# ALLOWED_ORIGINS=https://podium-xxxx.pages.dev

# ── Cloud Providers (all optional) ───────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

GITHUB_TOKEN=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Used for email verification and password reset emails.
# All SMTP configuration is via environment variables only (not stored in DB).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Podium <noreply@yourdomain.com>"
FRONTEND_URL=http://localhost:5173
