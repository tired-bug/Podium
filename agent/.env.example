# Port the agent listens on locally. The tunnel points at this port.
PORT=4500

# Required. Generate a long random string and put the SAME value in
# Podium Settings -> Cloud -> Docker Agent -> Agent Token.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=changeme-generate-a-real-token

# Optional. Comma-separated list of allowed origins for CORS.
# Leave blank to allow any origin (fine since the bearer token is the real gate).
ALLOWED_ORIGINS=
